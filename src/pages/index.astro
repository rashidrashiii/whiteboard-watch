---
import Layout from '../layouts/Layout.astro';
import data from '../data/companies.json';

const { companies } = data;

// Group by `section`, preserving first-seen order (the parser already
// emits entries in upstream README order, so this reproduces the
// upstream section ordering without re-sorting).
const sections = new Map<string, typeof companies>();
for (const company of companies) {
  const bucket = sections.get(company.section);
  if (bucket) {
    bucket.push(company);
  } else {
    sections.set(company.section, [company]);
  }
}

// Tag chips are offered in LLD §4's rule order, restricted to tags that
// actually occur in the synced data.
const TAG_ORDER = [
  'Remote',
  'Take-home project',
  'Pair programming',
  'System design',
  'Live coding',
  'Portfolio review',
  'Culture fit',
];
const presentTags = new Set(companies.flatMap((company) => company.tags));
const allTags = TAG_ORDER.filter((tag) => presentTags.has(tag));

function sectionSlug(section: string) {
  return `section-${section
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')}`;
}

function searchText(company: (typeof companies)[number]) {
  return `${company.name} ${company.location} ${company.description}`.toLowerCase();
}

function statusLabel(status: string, lastVerified: string | null) {
  if (status === 'ok') return `Verified ${lastVerified}`;
  if (status === 'broken') {
    return lastVerified ? `Broken link (last verified ${lastVerified})` : 'Broken link';
  }
  return 'Not yet checked';
}
---

<Layout>
  <main class="container page">
    <header class="page-header">
      <h1>WhiteboardWatch</h1>
      <p class="page-lead">
        {companies.length} companies that skip whiteboard-trivia interviews, synced daily from
        the community-maintained <a href={data.source}>hiring-without-whiteboards</a> list and
        checked for dead links.
      </p>
    </header>

    <div class="filter-bar" data-filter-bar>
      <div class="filter-search">
        <label class="visually-hidden" for="company-search">Search companies</label>
        <input
          type="search"
          id="company-search"
          class="search-input"
          placeholder="Search by name, location, or description"
          autocomplete="off"
          data-search-input
        />
      </div>
      {
        allTags.length > 0 && (
          <ul class="tag-filter-list" role="group" aria-label="Filter by tag">
            {allTags.map((tag) => (
              <li>
                <button type="button" class="tag-chip" data-tag={tag} aria-pressed="false">
                  {tag}
                </button>
              </li>
            ))}
          </ul>
        )
      }
      <p class="filter-result-count" data-result-count aria-live="polite">
        {companies.length} of {companies.length} companies shown
      </p>
    </div>

    <nav class="section-nav" aria-label="Jump to section">
      <ul class="section-nav-list">
        {
          [...sections.keys()].map((section) => (
            <li class="section-nav-item" data-section-nav-item={sectionSlug(section)}>
              <a href={`#${sectionSlug(section)}`} class="section-nav-link">
                {section}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="filter-empty" data-filter-empty aria-live="polite" hidden>
      No companies match your search and tag filters. Try removing a filter.
    </p>

    {
      [...sections.entries()].map(([section, entries]) => (
        <section class="section" id={sectionSlug(section)}>
          <h2 class="section-heading">{section}</h2>
          <ul class="entry-list">
            {entries.map((company) => (
              <li
                class="entry"
                data-entry
                data-search={searchText(company)}
                data-tags={company.tags.join('|')}
              >
                <div class="entry-head">
                  <h3 class="entry-name">
                    <a href={company.url}>{company.name}</a>
                  </h3>
                  {company.location && <span class="entry-location">{company.location}</span>}
                  <span class={`entry-status status-${company.linkStatus}`}>
                    <span class="status-dot" aria-hidden="true" />
                    {statusLabel(company.linkStatus, company.lastVerified)}
                  </span>
                </div>
                {company.description && <p class="entry-desc">{company.description}</p>}
                {(company.tags.length > 0 ||
                  company.salaryLinks.levelsFyi ||
                  company.salaryLinks.glassdoor) && (
                  <div class="entry-meta">
                    {company.tags.length > 0 && (
                      <ul class="entry-tags">
                        {company.tags.map((tag) => (
                          <li class="tag">{tag}</li>
                        ))}
                      </ul>
                    )}
                    {(company.salaryLinks.levelsFyi || company.salaryLinks.glassdoor) && (
                      <p class="entry-salary">
                        Search salary:{' '}
                        {company.salaryLinks.levelsFyi && (
                          <a href={company.salaryLinks.levelsFyi}>Levels.fyi</a>
                        )}
                        {company.salaryLinks.levelsFyi && company.salaryLinks.glassdoor && ', '}
                        {company.salaryLinks.glassdoor && (
                          <a href={company.salaryLinks.glassdoor}>Glassdoor</a>
                        )}
                      </p>
                    )}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Layout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
  const tagChips = document.querySelectorAll<HTMLButtonElement>('[data-tag]');
  const entries = document.querySelectorAll<HTMLElement>('[data-entry]');
  const sectionEls = document.querySelectorAll<HTMLElement>('.section');
  const resultCount = document.querySelector('[data-result-count]');
  const emptyState = document.querySelector<HTMLElement>('[data-filter-empty]');
  const totalCount = entries.length;

  const sectionNav = document.querySelector<HTMLElement>('.section-nav');
  const navLinksBySection = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.section-nav-link').forEach((link) => {
    const id = link.getAttribute('href')?.slice(1);
    if (id) navLinksBySection.set(id, link);
  });

  function setActiveSection(id: string) {
    navLinksBySection.forEach((link, sectionId) => {
      if (sectionId === id) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  if (sectionNav && 'IntersectionObserver' in window) {
    const navHeight = sectionNav.offsetHeight;
    const sectionObserver = new IntersectionObserver(
      (observerEntries) => {
        const active = observerEntries.find((entry) => entry.isIntersecting);
        if (active) setActiveSection(active.target.id);
      },
      { rootMargin: `-${navHeight}px 0px -70% 0px`, threshold: 0 },
    );

    sectionEls.forEach((sectionEl) => sectionObserver.observe(sectionEl));
  }

  const selectedTags = new Set<string>();
  let query = '';
  let debounceTimer: ReturnType<typeof setTimeout>;

  function applyFilters() {
    let visibleCount = 0;

    entries.forEach((entry) => {
      const search = entry.dataset.search ?? '';
      const tags = (entry.dataset.tags ?? '').split('|').filter(Boolean);
      const matchesQuery = query === '' || search.includes(query);
      const matchesTags = [...selectedTags].every((tag) => tags.includes(tag));
      const visible = matchesQuery && matchesTags;

      entry.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    });

    sectionEls.forEach((sectionEl) => {
      const sectionEntries = sectionEl.querySelectorAll<HTMLElement>('[data-entry]');
      const hasVisible = [...sectionEntries].some((entry) => !entry.classList.contains('hidden'));
      sectionEl.classList.toggle('hidden', !hasVisible);

      const navItem = document.querySelector<HTMLElement>(
        `[data-section-nav-item="${sectionEl.id}"]`,
      );
      navItem?.classList.toggle('hidden', !hasVisible);
    });

    if (resultCount) {
      resultCount.textContent = `${visibleCount} of ${totalCount} companies shown`;
    }

    if (!emptyState) return;

    if (visibleCount === 0) {
      emptyState.hidden = false;
      requestAnimationFrame(() => emptyState.classList.add('is-visible'));
    } else {
      emptyState.classList.remove('is-visible');
    }
  }

  // `hidden` (display: none) is applied only once the fade-out finishes,
  // otherwise it cuts the transition off before the browser paints it.
  document.querySelector<HTMLElement>('[data-filter-empty]')?.addEventListener(
    'transitionend',
    (event) => {
      if (event.propertyName !== 'opacity') return;
      const target = event.currentTarget as HTMLElement;
      if (!target.classList.contains('is-visible')) target.hidden = true;
    },
  );

  searchInput?.addEventListener('input', (event) => {
    const value = (event.target as HTMLInputElement).value;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      query = value.trim().toLowerCase();
      applyFilters();
    }, 180);
  });

  tagChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const tag = chip.dataset.tag;
      if (!tag) return;

      const isSelected = selectedTags.has(tag);
      if (isSelected) {
        selectedTags.delete(tag);
      } else {
        selectedTags.add(tag);
      }
      chip.setAttribute('aria-pressed', String(!isSelected));
      applyFilters();
    });
  });
</script>
