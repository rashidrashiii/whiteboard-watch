---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'WhiteboardWatch — companies that hire without whiteboard interviews',
  description = 'A self-updating, dead-link-checked directory of companies that skip whiteboard-trivia interviews, synced daily from the community-maintained hiring-without-whiteboards list.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <slot />
  </body>
</html>
